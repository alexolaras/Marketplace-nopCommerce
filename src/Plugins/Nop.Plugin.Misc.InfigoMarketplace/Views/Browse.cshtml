@model BrowseSearchModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.InfigoMarketplace.Browse.Title").Text;
    NopHtml.SetActiveMenuItemSystemName(InfigoMarketplaceDefaults.SystemName);
}

<link rel="stylesheet" href="~/Plugins/Misc.InfigoMarketplace/Content/styles.css" />

<div class="content-header clearfix">
    <h1 class="float-left mp-title">
        <i class="fas fa-box-open mp-title-icon"></i>
        @T("Plugins.Misc.InfigoMarketplace.Browse.Title")
    </h1>
    <div class="float-right">
        <button type="button" id="import-selected" class="btn mp-btn-primary">
            <i class="fas fa-cloud-arrow-down"></i>
            @T("Plugins.Misc.InfigoMarketplace.Browse.ImportSelected")
        </button>
        <nop-action-confirmation asp-button-id="import-selected" asp-additional-confirm="Plugins.Misc.InfigoMarketplace.Browse.ImportSelected.Confirm" />
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card mp-search-card">
                    <div class="card-body">
                        <div class="mp-search-row">
                            <div class="mp-search-field mp-search-field-name">
                                <label class="mp-search-label" asp-for="SearchName"></label>
                                <div class="mp-input-icon-wrapper">
                                    <i class="fas fa-magnifying-glass mp-input-icon"></i>
                                    <input asp-for="SearchName" class="form-control mp-input" placeholder="Package Name..." />
                                </div>
                            </div>
                            <div class="mp-search-field mp-search-field-category">
                                <label class="mp-search-label">&nbsp;</label>
                                <select asp-for="SearchCategoryId" asp-items="Model.AvailableCategories" class="form-control mp-select"></select>
                            </div>
                        </div>
                        <div class="mp-search-actions">
                            <button type="button" id="search-packages" class="btn mp-btn-primary">
                                <i class="fas fa-filter"></i>
                                @T("Admin.Common.Search")
                            </button>
                        </div>
                    </div>
                </div>

                <div id="packages-grid" class="mp-grid"></div>
            </div>
        </div>
    </div>
</section>

<nop-alert asp-alert-id="import-failed" />
<nop-alert asp-alert-id="nothingSelectedAlert" />

<script>
    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    var detailsUrlTemplate = '@Url.Action("Details", "InfigoMarketplaceAdmin", new { id = "__ID__" })';

    var pkgLabels = {
        version: '@T("Plugins.Misc.InfigoMarketplace.Browse.Fields.CurrentVersion")',
        installed: '@T("Plugins.Misc.InfigoMarketplace.Browse.Fields.Installed")',
        available: '@T("Plugins.Misc.InfigoMarketplace.Browse.Available")',
        uncategorized: '@T("Plugins.Misc.InfigoMarketplace.Browse.Uncategorized")'
    };

    function renderPackageCard(pkg) {
        var imageHtml = pkg.ImageUrl
            ? '<img src="' + escapeHtml(pkg.ImageUrl) + '" class="pkg-card-thumb" alt="' + escapeHtml(pkg.Name) + '">'
            : '<i class="fas fa-box pkg-card-thumb-placeholder"></i>';

        var url = detailsUrlTemplate.replace('__ID__', encodeURIComponent(pkg.Id));

        var versionHtml = pkg.CurrentVersion
            ? '<span class="pkg-card-version">' + pkgLabels.version + ' ' + escapeHtml(pkg.CurrentVersion) + '</span>'
            : '';

        var descriptionHtml = pkg.Description
            ? '<div class="pkg-card-description">' + escapeHtml(pkg.Description) + '</div>'
            : '';

        var typeLabel = pkg.Type ? escapeHtml(pkg.Type) : pkgLabels.uncategorized;

        var statusClass = pkg.Installed ? 'pkg-card-status-installed' : 'pkg-card-status-available';
        var statusLabel = pkg.Installed ? pkgLabels.installed : pkgLabels.available;

        return '<a class="pkg-card" href="' + url + '">' +
            '<div class="pkg-card-image">' +
                '<span class="pkg-card-menu" aria-hidden="true"><i class="fas fa-ellipsis-vertical"></i></span>' +
                imageHtml +
            '</div>' +
            '<div class="pkg-card-body">' +
                '<div class="pkg-card-title">' + escapeHtml(pkg.Name) + '</div>' +
                versionHtml +
                descriptionHtml +
                '<div class="pkg-card-footer">' +
                    '<span class="pkg-card-category"><i class="far fa-comment"></i> ' + typeLabel + '</span>' +
                    '<span class="pkg-card-status ' + statusClass + '"><i class="fas fa-circle-down"></i> ' + statusLabel + '</span>' +
                '</div>' +
            '</div>' +
            '</a>';
    }

    function loadPackages() {
        var postData = {
            SearchName: $('#SearchName').val(),
            SearchCategoryId: $('#SearchCategoryId').val(),
            pageSize: @Model.PageSize
        };
        addAntiForgeryToken(postData);
        $('#packages-grid').html(
            '<div class="mp-grid-loading"><i class="fas fa-spinner fa-spin fa-2x"></i></div>'
        );
        $.ajax({
            cache: false,
            type: 'POST',
            url: '@(Url.Action("BrowsePackageList", "InfigoMarketplaceAdmin"))',
            data: postData,
            error: function (jqXHR, textStatus, errorThrown) {
                $('#packages-grid').html(
                    '<div class="mp-grid-error">' + escapeHtml(errorThrown) + '</div>'
                );
            },
            success: function (data) {
                var grid = $('#packages-grid');
                grid.empty();
                if (!data || !data.Data || data.Data.length === 0) {
                    grid.html('<div class="mp-grid-empty">@T("Plugins.Misc.InfigoMarketplace.Browse.NoItems")</div>');
                    return;
                }
                $.each(data.Data, function (i, pkg) {
                    grid.append(renderPackageCard(pkg));
                });
            }
        });
    }

    $(function () {
        loadPackages();

        $('#search-packages').on('click', function () {
            loadPackages();
        });

        $('#SearchName').on('keydown', function (e) {
            if (e.key === 'Enter') loadPackages();
        });

        $('#import-selected-action-confirmation-submit-button').on('click', function () {
            $('#import-selected-action-confirmation').modal('toggle');
            var ids = $('.checkbox-package:checked').map(function () { return $(this).val(); }).get();
            postImport(ids);
            return false;
        });

        $(document).on('click', '.import-single', function (e) {
            e.preventDefault();
            postImport([$(this).data('id')]);
        });
    });
</script>
