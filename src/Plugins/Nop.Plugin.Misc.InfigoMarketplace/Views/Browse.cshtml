@model BrowseSearchModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.InfigoMarketplace.Browse.Title").Text;
    NopHtml.SetActiveMenuItemSystemName(InfigoMarketplaceDefaults.SystemName);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Misc.InfigoMarketplace.Browse.Title")
    </h1>
    <div class="float-right">
        <button type="button" id="import-selected" class="btn btn-primary">
            <i class="fas fa-cloud-arrow-down"></i>
            @T("Plugins.Misc.InfigoMarketplace.Browse.ImportSelected")
        </button>
        <nop-action-confirmation asp-button-id="import-selected" asp-additional-confirm="Plugins.Misc.InfigoMarketplace.Browse.ImportSelected.Confirm" />
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="SearchName" />
                                    </div>
                                    <div class="col-md-8">
                                        <nop-editor asp-for="SearchName" />
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="SearchCategoryId" />
                                    </div>
                                    <div class="col-md-8">
                                        <nop-select asp-for="SearchCategoryId" asp-items="Model.AvailableCategories" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="text-center col-12">
                                <button type="button" id="search-packages" class="btn btn-primary btn-search">
                                    <i class="fas fa-magnifying-glass"></i>
                                    @T("Admin.Common.Search")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "infigo-packages-grid",
                            UrlRead = new DataUrl("BrowsePackageList", "InfigoMarketplaceAdmin", null),
                            SearchButtonId = "search-packages",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new FilterParameter(nameof(Model.SearchName)),
                                new FilterParameter(nameof(Model.SearchCategoryId))
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(PackageModel.Id))
                                {
                                    IsMasterCheckBox = true,
                                    Render = new RenderCheckBox("checkbox_packages"),
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Width = "50"
                                },
                                new ColumnProperty(nameof(PackageModel.Name))
                                {
                                    Title = T("Plugins.Misc.InfigoMarketplace.Browse.Fields.Name").Text
                                },
                                new ColumnProperty(nameof(PackageModel.Description))
                                {
                                    Title = T("Plugins.Misc.InfigoMarketplace.Browse.Fields.Description").Text
                                },
                                new ColumnProperty(nameof(PackageModel.CategoryName))
                                {
                                    Title = T("Plugins.Misc.InfigoMarketplace.Browse.Fields.Category").Text
                                },
                                new ColumnProperty(nameof(PackageModel.Type))
                                {
                                    Title = T("Plugins.Misc.InfigoMarketplace.Browse.Fields.Type").Text,
                                    Width = "120"
                                },
                                new ColumnProperty(nameof(PackageModel.CurrentVersion))
                                {
                                    Title = T("Plugins.Misc.InfigoMarketplace.Browse.Fields.CurrentVersion").Text,
                                    Width = "120"
                                },
                                new ColumnProperty(nameof(PackageModel.Tags))
                                {
                                    Title = T("Plugins.Misc.InfigoMarketplace.Browse.Fields.Tags").Text
                                },
                                new ColumnProperty(nameof(PackageModel.Installed))
                                {
                                    Title = T("Plugins.Misc.InfigoMarketplace.Browse.Fields.Installed").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean()
                                },
                                new ColumnProperty(nameof(PackageModel.InstalledProductId))
                                {
                                    Title = T("Admin.Common.Edit").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.Button,
                                    Render = new RenderCustom("renderProductEditButton")
                                },
                                new ColumnProperty(nameof(PackageModel.Id))
                                {
                                    Title = T("Plugins.Misc.InfigoMarketplace.Browse.Fields.Action").Text,
                                    Width = "120",
                                    ClassName = NopColumnClassDefaults.Button,
                                    Render = new RenderCustom("renderImportButton")
                                }
                            }
                        })

                        <script>
                            function renderProductEditButton(data, type, row, meta) {
                                if (!data) {
                                    return '';
                                }
                                var url = '@Url.Content("~/Admin/Product/Edit/")' + encodeURIComponent(data);
                                return '<a class="btn btn-default" href="' + url + '"><i class="fas fa-pencil-alt"></i>&nbsp;@T("Admin.Common.Edit")</a>';
                            }

                            function renderImportButton(data, type, row, meta) {
                                if (!data) {
                                    return '';
                                }
                                var label = row.Installed
                                    ? '@T("Plugins.Misc.InfigoMarketplace.Browse.ReImport")'
                                    : '@T("Plugins.Misc.InfigoMarketplace.Browse.Import")';
                                var cls = row.Installed ? 'btn-secondary' : 'btn-primary';
                                return '<button type="button" class="btn ' + cls + ' import-single" data-id="' + data + '">' +
                                    '<i class="fas fa-cloud-arrow-down"></i>&nbsp;' + label + '</button>';
                            }

                            $(function () {
                                function postImport(ids) {
                                    var postData = { selectedIds: ids };
                                    addAntiForgeryToken(postData);
                                    $.ajax({
                                        cache: false,
                                        type: 'POST',
                                        url: '@(Url.Action("Import", "InfigoMarketplaceAdmin"))',
                                        data: postData,
                                        traditional: true,
                                        beforeSend: function () {
                                            showThrobber('@T("Plugins.Misc.InfigoMarketplace.Browse.Importing")');
                                        },
                                        error: function (jqXHR, textStatus, errorThrown) {
                                            showAlert('import-failed', errorThrown);
                                        },
                                        success: function (data) {
                                            if (data && data.message) {
                                                displayBarNotification(data.message, data.success ? 0 : 1, 5000);
                                            }
                                        },
                                        complete: function (jqXHR) {
                                            $('.throbber').hide();
                                            window.setTimeout(function () { $('.throbber').hide(); }, 1100);
                                            if (jqXHR.status === 204) {
                                                showAlert('nothingSelectedAlert', '@T("Admin.Common.Alert.NothingSelected")');
                                                return;
                                            }
                                            updateTable('#infigo-packages-grid');
                                        }
                                    });
                                }

                                $('#import-selected-action-confirmation-submit-button').on('click', function () {
                                    $('#import-selected-action-confirmation').modal('toggle');
                                    postImport(selectedIds);
                                    return false;
                                });

                                $('#infigo-packages-grid').on('click', '.import-single', function (e) {
                                    e.preventDefault();
                                    var id = $(this).data('id');
                                    postImport([id]);
                                });
                            });
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<nop-alert asp-alert-id="import-failed" />
<nop-alert asp-alert-id="nothingSelectedAlert" />
