@model BrowseSearchModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.InfigoMarketplace.Browse.Title").Text;
    NopHtml.SetActiveMenuItemSystemName(InfigoMarketplaceDefaults.SystemName);
}

<link rel="stylesheet" href="~/Plugins/Misc.InfigoMarketplace/Content/styles.css" />

<div class="content-header clearfix">
    <h1 class="float-left mp-title">
        <i class="fas fa-box-open mp-title-icon"></i>
        @T("Plugins.Misc.InfigoMarketplace.Browse.Title")
    </h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card mp-search-card">
                    <div class="card-body">
                        <div class="mp-search-row">
                            <div class="mp-search-field mp-search-field-name">
                                <label class="mp-search-label" asp-for="SearchName"></label>
                                <div class="mp-input-icon-wrapper">
                                    <i class="fas fa-magnifying-glass mp-input-icon"></i>
                                    <input asp-for="SearchName" class="form-control mp-input" placeholder="Package Name..." />
                                </div>
                            </div>
                            <div class="mp-search-field mp-search-field-category">
                                <label class="mp-search-label">&nbsp;</label>
                                <select asp-for="SearchCategoryId" asp-items="Model.AvailableCategories" class="form-control mp-select"></select>
                            </div>
                        </div>
                        <div class="mp-search-actions">
                            <button type="button" id="search-packages" class="btn mp-btn-primary">
                                <i class="fas fa-filter"></i>
                                @T("Admin.Common.Search")
                            </button>
                        </div>
                    </div>
                </div>

                <div id="packages-grid" class="mp-grid"></div>
                <div id="packages-pager" class="mp-pager"></div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const detailsUrlTemplate = '@Url.Action("Details", "InfigoMarketplaceAdmin", new { id = "__ID__" })';
        const listUrl = '@(Url.Action("BrowsePackageList", "InfigoMarketplaceAdmin"))';
        const pageSize = @Model.PageSize;
        const noItemsHtml = '<div class="mp-grid-empty">@T("Plugins.Misc.InfigoMarketplace.Browse.NoItems")</div>';

        const pkgLabels = {
            version: '@T("Plugins.Misc.InfigoMarketplace.Browse.Fields.CurrentVersion")',
            installed: '@T("Plugins.Misc.InfigoMarketplace.Browse.Fields.Installed")',
            available: '@T("Plugins.Misc.InfigoMarketplace.Browse.Available")',
            uncategorized: '@T("Plugins.Misc.InfigoMarketplace.Browse.Uncategorized")'
        };

        let currentPage = 1;
        let activeRequest = null;

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function renderPackageCard(pkg) {
            const url = detailsUrlTemplate.replace('__ID__', encodeURIComponent(pkg.Id));
            const name = escapeHtml(pkg.Name);
            const imageHtml = pkg.ImageUrl
                ? `<img src="${escapeHtml(pkg.ImageUrl)}" class="pkg-card-thumb" alt="${name}">`
                : '<i class="fas fa-box pkg-card-thumb-placeholder"></i>';
            const versionHtml = pkg.CurrentVersion
                ? `<span class="pkg-card-version">${pkgLabels.version} ${escapeHtml(pkg.CurrentVersion)}</span>`
                : '';
            const descriptionHtml = pkg.Description
                ? `<div class="pkg-card-description">${escapeHtml(pkg.Description)}</div>`
                : '';
            const typeLabel = pkg.Type ? escapeHtml(pkg.Type) : pkgLabels.uncategorized;
            const statusClass = pkg.Installed ? 'pkg-card-status-installed' : 'pkg-card-status-available';
            const statusLabel = pkg.Installed ? pkgLabels.installed : pkgLabels.available;

            return `<a class="pkg-card" href="${url}">
                <div class="pkg-card-image">${imageHtml}</div>
                <div class="pkg-card-body">
                    <div class="pkg-card-title">${name}</div>
                    ${versionHtml}
                    ${descriptionHtml}
                    <div class="pkg-card-footer">
                        <span class="pkg-card-category"><i class="far fa-comment"></i> ${typeLabel}</span>
                        <span class="pkg-card-status ${statusClass}"><i class="fas fa-circle-down"></i> ${statusLabel}</span>
                    </div>
                </div>
            </a>`;
        }

        function buildPageWindow(current, total) {
            if (total <= 7) {
                const pages = [];
                for (let i = 1; i <= total; i++) pages.push(i);
                return pages;
            }
            const pages = [1];
            const start = Math.max(2, current - 1);
            const end = Math.min(total - 1, current + 1);
            if (start > 2) pages.push('...');
            for (let p = start; p <= end; p++) pages.push(p);
            if (end < total - 1) pages.push('...');
            pages.push(total);
            return pages;
        }

        function pagerButton(page, label, { active = false, disabled = false } = {}) {
            const classes = ['mp-pager-btn'];
            if (active) classes.push('mp-pager-btn-active');
            const attrs = disabled ? ' disabled' : '';
            return `<button type="button" class="${classes.join(' ')}" data-page="${page}"${attrs}>${label}</button>`;
        }

        function renderPager(total) {
            const totalPages = Math.max(1, Math.ceil((total || 0) / pageSize));
            const parts = [pagerButton(currentPage - 1, '<i class="fas fa-chevron-left"></i>', { disabled: currentPage <= 1 })];
            for (const p of buildPageWindow(currentPage, totalPages)) {
                if (p === '...') parts.push('<span class="mp-pager-ellipsis">…</span>');
                else parts.push(pagerButton(p, p, { active: p === currentPage }));
            }
            parts.push(pagerButton(currentPage + 1, '<i class="fas fa-chevron-right"></i>', { disabled: currentPage >= totalPages }));
            $('#packages-pager').html(parts.join(''));
        }

        function loadPackages() {
            if (activeRequest) activeRequest.abort();

            const postData = {
                SearchName: $('#SearchName').val(),
                SearchCategoryId: $('#SearchCategoryId').val(),
                Start: (currentPage - 1) * pageSize,
                Length: pageSize
            };
            addAntiForgeryToken(postData);

            $('#packages-grid').html('<div class="mp-grid-loading"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');
            $('#packages-pager').empty();

            activeRequest = $.ajax({
                cache: false,
                type: 'POST',
                url: listUrl,
                data: postData,
                error: function (jqXHR, textStatus, errorThrown) {
                    if (textStatus === 'abort') return;
                    $('#packages-grid').html('<div class="mp-grid-error">' + escapeHtml(errorThrown) + '</div>');
                },
                success: function (data) {
                    const grid = $('#packages-grid');
                    if (!data || !data.Data || data.Data.length === 0) {
                        grid.html(noItemsHtml);
                        return;
                    }
                    grid.html(data.Data.map(renderPackageCard).join(''));
                    renderPager(data.recordsTotal);
                },
                complete: function () { activeRequest = null; }
            });
        }

        $(function () {
            loadPackages();

            $('#search-packages').on('click', function () {
                currentPage = 1;
                loadPackages();
            });

            $('#SearchName').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    currentPage = 1;
                    loadPackages();
                }
            });

            $(document).on('click', '#packages-pager .mp-pager-btn', function () {
                if ($(this).is(':disabled') || $(this).hasClass('mp-pager-btn-active')) return;
                const page = parseInt($(this).data('page'), 10);
                if (isNaN(page) || page < 1) return;
                currentPage = page;
                loadPackages();
            });
        });
    })();
</script>
